# Optional config for the eval harness (`npm run eval`) only.
# The published library and `npm run scan` CLI do NOT read this file.
#
# The eval harness crawls live known-bad URLs (OpenPhish / URLhaus). Many ISPs
# intercept known-bad hosts, which tanks recall. Point these at an unfiltered
# outbound proxy so the crawl reaches the real content. The npm script sets
# NODE_USE_ENV_PROXY=1 so Node's fetch routes through them.
#
# Leave unset to crawl directly (recall may drop if your network filters bad hosts).
EVAL_PROXY_URL=http://user:pass@proxy-host:port
HTTP_PROXY=http://user:pass@proxy-host:port
HTTPS_PROXY=http://user:pass@proxy-host:port
